{
  "name": "Main Branch Protection",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": ["main"]
    }
  },
  "rules": [
    {
      "type": "block_pushes",
      "parameters": {
        "restricted_actors": ["*"],
        "allowed_actors": ["REPOSITORY_OWNER"]
      }
    },
    {
      "type": "block_force_pushes",
      "parameters": {
        "enabled": true
      }
    },
    {
      "type": "block_deletions",
      "parameters": {
        "enabled": true
      }
    },
    {
      "type": "required_pull_request",
      "parameters": {
        "required_approvals": 0,
        "dismiss_stale_reviews_on_push": false,
        "bypass_actors": ["REPOSITORY_OWNER"]
      }
    },
    {
      "type": "file_protection",
      "parameters": {
        "file_patterns": ["/**"],
        "block_modifications": true,
        "allowed_actors": ["REPOSITORY_OWNER"]
      }
    }
  ]
}
